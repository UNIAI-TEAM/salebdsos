# =============================================================================
# UNICOM NFC PLATFORM — ENVIRONMENT VARIABLES (on-premise)
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# =============================================================================

# ---- App ----
NODE_ENV=production
APP_URL=https://app.example.com           # public URL of the frontend
APP_PORT=3000
LOG_LEVEL=info                            # debug|info|warn|error
SESSION_SECRET=change-me-32-bytes-min     # random 32+ bytes
JWT_SECRET=change-me-32-bytes-min         # random 32+ bytes (for auth tokens)

# ---- Database (PostgreSQL 14+) ----
DATABASE_URL=postgres://unicom:STRONGPASS@postgres:5432/unicom?sslmode=disable
POSTGRES_USER=unicom
POSTGRES_PASSWORD=STRONGPASS
POSTGRES_DB=unicom
DATABASE_POOL_MAX=20

# ---- Auth (self-hosted Supabase OR custom) ----
# Mode: "supabase" (use bundled GoTrue) | "custom" (use built-in JWT auth)
AUTH_PROVIDER=supabase
SUPABASE_URL=http://supabase-kong:8000     # only if AUTH_PROVIDER=supabase
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# OAuth (optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Object Storage ----
# Provider: "s3" (AWS / MinIO / Wasabi / R2) | "local" (filesystem, dev only)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=unicom-prod
S3_ENDPOINT=http://minio:9000             # leave blank for AWS
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true                  # true for MinIO, false for AWS
STORAGE_PUBLIC_BASE_URL=https://cdn.example.com   # CDN in front of bucket
STORAGE_LOCAL_PATH=/var/lib/unicom/files  # only if STORAGE_PROVIDER=local

# ---- Cache / Queue ----
REDIS_URL=redis://redis:6379/0

# ---- Email ----
# Provider: "smtp" | "resend" | "sendgrid" | "ses" | "lovable"
EMAIL_PROVIDER=smtp
EMAIL_FROM="UNICOM <noreply@example.com>"
EMAIL_REPLY_TO=support@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=
SENDGRID_API_KEY=
AWS_SES_REGION=

# ---- SMS ----
# Provider: "twilio" | "esms" | "vietguys" | "vonage" | "noop"
SMS_PROVIDER=esms
SMS_FROM=UNICOM
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
VIETGUYS_TOKEN=
VONAGE_API_KEY=
VONAGE_API_SECRET=

# ---- Zalo OA / ZNS ----
ZALO_PROVIDER=zns                         # "zns" | "noop"
ZALO_OA_ID=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=
ZALO_APP_ID=
ZALO_APP_SECRET=

# ---- AI ----
# Provider: "lovable" | "openai" | "gemini" | "anthropic" | "ollama" | "azure-openai"
AI_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
LOVABLE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ---- Observability (optional) ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Misc ----
RATE_LIMIT_PER_MINUTE=120
ENABLE_SIGNUP=true
DEFAULT_LOCALE=vi
